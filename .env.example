# Production: full Power Automate HTTP POST URL (from the trigger card). Required for `npm run build` / hosted site.
# If the trigger is "Any user in my tenant", anonymous POSTs get 401 — set "Who can trigger" to "Anyone", save, then use the NEW URL (often includes sp= and sig=).
VITE_POWER_AUTOMATE_DEMO_URL=

# Local dev only: same full POST URL for the Vite proxy. Does NOT use the VITE_ prefix so it is not bundled into client JS.
# Copy from Power Automate after save. Example: https://....powerplatform.com/powerautomate/.../invoke?api-version=1&sp=...&sig=...
POWER_AUTOMATE_HTTP_URL=
