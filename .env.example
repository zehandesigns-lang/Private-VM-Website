# Power Automate HTTP POST URL (from the trigger card).
# - Local dev: used by the Vite proxy at `/api/powerautomate-demo`
# - Vercel prod: used by the Vercel Serverless Function at `/api/powerautomate-demo`
#
# If the trigger is "Any user in my tenant", anonymous POSTs get 401 — set "Who can trigger" to "Anyone",
# save the flow, then use the NEW POST URL (often includes sp= and sig=).
POWER_AUTOMATE_HTTP_URL=

# Optional override for Wayship AI-native timeline video (defaults to Vercel Blob URL in src/app/constants/wayship.ts)
VITE_WAYSHIP_TIMELINE_VIDEO_URL=https://3tlydecb7z685omc.public.blob.vercel-storage.com/new-timeline.mp4
